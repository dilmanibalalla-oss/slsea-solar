NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/solar_api
JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret
JWT_ISSUER=solar-api
JWT_AUDIENCE=solar-clients
PUBLIC_API_URL=https://your-vercel-app.vercel.app

# Seed replaces geography/readings only. User passwords of existing accounts are never reset.
SEED_CONFIRM=solar_api

# Used only when creating a missing role account (existing hashes are kept).
SEED_ADMIN_PASSWORD=replace-with-16-plus-character-admin-password
SEED_ANALYST_PASSWORD=replace-with-16-plus-character-analyst-password

# Optional explicit usernames/passwords for missing role accounts.
# Do not put these values in Swagger; LoginPayload examples are documentation only.
ACCOUNT_ADMIN_USERNAME=admin
ACCOUNT_ADMIN_PASSWORD=
ACCOUNT_ADMIN_NAME=Administrator
ACCOUNT_ADMIN_EMAIL=admin@slsea.example

ACCOUNT_NATIONAL_USERNAME=national
ACCOUNT_NATIONAL_PASSWORD=
ACCOUNT_NATIONAL_NAME=National Analyst
ACCOUNT_NATIONAL_EMAIL=national@slsea.example

ACCOUNT_PROVINCE_USERNAME=western
ACCOUNT_PROVINCE_PASSWORD=
ACCOUNT_PROVINCE_NAME=Provincial Analyst
ACCOUNT_PROVINCE_EMAIL=western@slsea.example
ACCOUNT_PROVINCE_JURISDICTION_ID=

ACCOUNT_DISTRICT_USERNAME=colombo
ACCOUNT_DISTRICT_PASSWORD=
ACCOUNT_DISTRICT_NAME=District Analyst
ACCOUNT_DISTRICT_EMAIL=colombo@slsea.example
ACCOUNT_DISTRICT_JURISDICTION_ID=
